<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Winterization_Sent_Email</name>
        <label>Send Winterization Sent Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recipientAddresses</name>
            <value>
                <collectionElements>
                    <elementReference>ccEmailAddresses</elementReference>
                </collectionElements>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>OrgWideEmailAddress</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderAddress</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>office@premierswim.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>composeEmailContent</name>
            <value>
                <stringValue>True</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>EmailSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>{!EmailBody}</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>relatedRecordId</name>
            <value>
                <elementReference>Get_Case.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
        <versionString>2.0.1</versionString>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Email_To_Collection</name>
        <label>Add Email To Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ccEmailAddresses</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_CC_Recipients.dfsle__Email__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_CC_Recipients</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_CC_Recipients</name>
        <label>Count CC Recipients</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ccRecipientCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_CC_Recipients</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_Any_CCs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_Emails_To_Send</name>
        <label>Count Emails To Send</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ccEmailCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>ccEmailAddresses</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_Has_Emails_To_Send</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decision_Any_CCs</name>
        <label>Any CCs?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No CCs</defaultConnectorLabel>
        <rules>
            <name>Has_CC_Recipients</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ccRecipientCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_CC_Recipients</targetReference>
            </connector>
            <label>Has CC Recipients</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Case_Found</name>
        <label>Winterization Case Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not a Winterization Case</defaultConnectorLabel>
        <rules>
            <name>Case_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account</targetReference>
            </connector>
            <label>Winterization Case Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Has_Email</name>
        <label>Has Email?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_CC_Recipients</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Skip Blank Email</defaultConnectorLabel>
        <rules>
            <name>Email_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_CC_Recipients.dfsle__Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_CC_Recipients.dfsle__Email__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Email_To_Collection</targetReference>
            </connector>
            <label>Email Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Has_Emails_To_Send</name>
        <label>Has Emails To Send?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Emails</defaultConnectorLabel>
        <rules>
            <name>Ready_To_Send</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ccEmailCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Winterization_Sent_Email</targetReference>
            </connector>
            <label>Ready To Send</label>
        </rules>
    </decisions>
    <description>Sends a Salesforce email to all DocuSign Carbon Copy recipients when a Winterization Letters envelope is sent. Matches Envelope Configuration Winterization Letters (a0DVv000012UXI3MAO). Recipients are selected by Type=CarbonCopy, not Role name: roles on this template are Carbon Copy, Carbon Copy 2, and Regional Manager. Signer 1 is excluded.</description>
    <environments>Default</environments>
    <interviewLabel>Winterization DocuSign CC Sent Notify {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Winterization DocuSign CC Sent Notify</label>
    <loops>
        <name>Loop_CC_Recipients</name>
        <label>Loop CC Recipients</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_CC_Recipients</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_Has_Email</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Count_Emails_To_Send</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Account</name>
        <label>Get Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_CC_Recipients</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_CC_Recipients</name>
        <label>Get CC Recipients</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_CC_Recipients</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>dfsle__Envelope__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>dfsle__Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CarbonCopy</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>dfsle__Recipient__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>dfsle__Email__c</queriedFields>
        <queriedFields>dfsle__Role__c</queriedFields>
        <queriedFields>dfsle__Type__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Case</name>
        <label>Get Winterization Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Case_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.dfsle__SourceId__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>CaseNumber</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>AccountId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Case</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>dfsle__SourceId__c</field>
            <operator>StartsWith</operator>
            <value>
                <stringValue>500</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sent</stringValue>
            </value>
        </filters>
        <filters>
            <field>dfsle__EnvelopeConfiguration__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>a0DVv000012UXI3MAO</stringValue>
            </value>
        </filters>
        <object>dfsle__Envelope__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <textTemplates>
        <name>EmailBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Hello,

The winterization envelope for Case {!Get_Case.CaseNumber} ({!Get_Case.Subject}) related to {!Get_Account.Name} was sent via DocuSign.

This is a Salesforce notification to DocuSign carbon copy recipients on the envelope.</text>
    </textTemplates>
    <textTemplates>
        <name>EmailSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Winterization sent – {!Get_Case.CaseNumber}</text>
    </textTemplates>
