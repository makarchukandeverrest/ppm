<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Viewed_Notification</name>
        <label>Send Viewed Notification</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>Get_Notification_Type.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>ccUserIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <elementReference>NotificationTitle</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>NotificationBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>NotificationTargetId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_CC_User_Id</name>
        <label>Add CC User Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ccUserIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_User_By_Email.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_CC_Recipients</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_CC_Recipients</name>
        <label>Count CC Recipients</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ccRecipientCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_CC_Recipients</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_Any_CC_Recipients</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decision_Any_CC_Recipients</name>
        <label>Any CC Recipients?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No CC Recipients</defaultConnectorLabel>
        <rules>
            <name>Has_CC_Recipients</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ccRecipientCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_CC_Recipients</targetReference>
            </connector>
            <label>Has CC Recipients</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_CC_Email_Present</name>
        <label>CC Email Present?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_CC_Recipients</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Skip Blank Email</defaultConnectorLabel>
        <rules>
            <name>CC_Email_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_CC_Recipients.dfsle__Email__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_User_By_Email</targetReference>
            </connector>
            <label>CC Email Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Envelope_Found</name>
        <label>Envelope Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Envelope</defaultConnectorLabel>
        <rules>
            <name>Envelope_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Envelope.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_CC_Recipients</targetReference>
            </connector>
            <label>Envelope Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Has_CC_Users</name>
        <label>Has CC Users?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No CC Users</defaultConnectorLabel>
        <rules>
            <name>Has_CC_Users</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ccUserIds</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Viewed_Notification</targetReference>
            </connector>
            <label>Has CC Users</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_User_Found</name>
        <label>User Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_CC_Recipients</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>User Not Found</defaultConnectorLabel>
        <rules>
            <name>Active_User_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_User_By_Email.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_CC_User_Id</targetReference>
            </connector>
            <label>Active User Found</label>
        </rules>
    </decisions>
    <description>Sends an internal Salesforce bell notification to all DocuSign carbon copy users when a recipient status changes to Viewed. CC users are matched to active Salesforce users by email.</description>
    <environments>Default</environments>
    <formulas>
        <name>NotificationTargetId</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Get_Contract_Bid.Id})), {!Get_Contract_Bid.Id}, IF(NOT(ISBLANK({!Get_Envelope.Id})), {!Get_Envelope.Id}, {!$Record.dfsle__EnvelopeStatus__c}))</expression>
    </formulas>
    <interviewLabel>DocuSign Envelope Viewed CC Notify {!$Flow.CurrentDateTime}</interviewLabel>
    <label>DocuSign Envelope Viewed CC Notify</label>
    <loops>
        <name>Loop_CC_Recipients</name>
        <label>Loop CC Recipients</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_CC_Recipients</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_CC_Email_Present</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Decision_Has_CC_Users</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_CC_Recipients</name>
        <label>Get CC Recipients</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_CC_Recipients</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>dfsle__Envelope__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Envelope.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>dfsle__Role__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Carbon Copy</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>dfsle__Recipient__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>dfsle__Email__c</queriedFields>
        <queriedFields>dfsle__Role__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Contract_Bid</name>
        <label>Get Contract Bid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Envelope_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.dfsle__EnvelopeStatus__r.dfsle__SourceId__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contract_Bid__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Envelope</name>
        <label>Get Envelope</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Contract_Bid</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>dfsle__DocuSignId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.dfsle__EnvelopeStatus__r.dfsle__DocuSignId__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>dfsle__Envelope__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>dfsle__EmailSubject__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Notification_Type</name>
        <label>Get Notification Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Envelope</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>DocuSign_Envelope_Viewed</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_User_By_Email</name>
        <label>Get User By Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_User_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_CC_Recipients.dfsle__Email__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Email</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Notification_Type</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>dfsle__Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Viewed</stringValue>
            </value>
        </filters>
        <object>dfsle__RecipientStatus__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <textTemplates>
        <name>NotificationBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>A DocuSign recipient has viewed the envelope.

Envelope Subject: {!$Record.dfsle__EnvelopeStatus__r.dfsle__EmailSubject__c}
Viewed Recipient: {!$Record.dfsle__Email__c}
Contract Bid: {!Get_Contract_Bid.Name}
Status: Viewed</text>
    </textTemplates>
    <textTemplates>
        <name>NotificationTitle</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>DocuSign Envelope Viewed: {!$Record.dfsle__EnvelopeStatus__r.dfsle__EmailSubject__c}</text>
    </textTemplates>
    <variables>
        <name>ccRecipientCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>ccUserIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
