            </connector>
            <label>Sent</label>
        </rules>
        <rules>
            <name>Status_Viewed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.dfsle__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Viewed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Log_Viewed_Post</targetReference>
            </connector>
            <label>Viewed</label>
        </rules>
        <rules>
            <name>Status_Delivered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.dfsle__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Delivered</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Log_Delivered_Post</targetReference>
            </connector>
            <label>Delivered</label>
        </rules>
    </decisions>
    <description
  >Chatter log on the Contract Bid when a DocuSign signer recipient status becomes Sent, Viewed, or Delivered. Runs on each status change, not only the first time the recipient enters the status group. Sent attaches the contract file. Viewed and Delivered are text posts and name the Lead Generator and Regional Manager. Does not change the bid stage.</description>
    <environments>Default</environments>
    <formulas>
        <name>IsContractBid</name>
        <dataType>Boolean</dataType>
        <expression
    >BEGINS({!$Record.dfsle__EnvelopeStatus__r.dfsle__SourceId__c}, "a0b")</expression>
    </formulas>
    <formulas>
        <name>LeadGeneratorName</name>
        <dataType>String</dataType>
        <expression
    >IF(ISBLANK({!Get_Lead_Generator.Name}), "not assigned", {!Get_Lead_Generator.Name})</expression>
    </formulas>
    <formulas>
        <name>RegionalManagerName</name>
        <dataType>String</dataType>
        <expression
    >IF(ISBLANK({!Get_Regional_Manager.Name}), "not assigned", {!Get_Regional_Manager.Name})</expression>
    </formulas>
    <interviewLabel
  >Contract Bid DocuSign Recipient Status Log {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contract Bid DocuSign Recipient Status Log</label>
