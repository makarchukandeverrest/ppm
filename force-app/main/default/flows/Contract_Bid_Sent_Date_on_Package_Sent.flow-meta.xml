    <assignments>
        <name>Set_Sent_Contract_Date</name>
        <label>Set Sent Contract Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Sent_Contract_Date__c</assignToReference>
            <operator>Assign</operator>
