        <label>Error Contact Not Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>The Account&apos;s Primary Contact record could not be found.</errorMessage>
            <fieldSelection>WhoId</fieldSelection>
            <isFieldError>true</isFieldError>
