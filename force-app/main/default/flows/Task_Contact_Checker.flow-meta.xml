        <label>Error Primary Contact Blank</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Set Primary Contact on the related Account before saving this Task.</errorMessage>
            <fieldSelection>WhoId</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Decision_1</name>
        <label>Decision 1</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Contact_related</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>False</defaultConnectorLabel>
        <rules>
            <name>True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TaskContacts</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Get_Contact.Id</elementReference>
                </rightValue>
            </conditions>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Account_Id_On_Opportunity</name>
        <label>Account Id On Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Error_Opportunity_No_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Account On Opportunity</defaultConnectorLabel>
        <rules>
            <name>Has_Account_Id</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Customer_Contact</targetReference>
            </connector>
            <label>Has Account Id</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Contact_Resolved</name>
