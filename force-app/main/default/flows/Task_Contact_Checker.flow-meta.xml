        <customErrorMessages>
            <errorMessage>Contact must be related to Opportunity</errorMessage>
            <fieldSelection>WhoId</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
