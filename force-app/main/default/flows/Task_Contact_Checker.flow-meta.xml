        <label>Error Opportunity No Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>The related Opportunity has no Account. Link an Account to the Opportunity first.</errorMessage>
            <fieldSelection>WhatId</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Error_Opportunity_Not_Found</name>
        <label>Error Opportunity Not Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>The related Opportunity could not be found.</errorMessage>
            <fieldSelection>WhatId</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
