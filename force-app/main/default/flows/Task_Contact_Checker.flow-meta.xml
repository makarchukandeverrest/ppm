                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Decision_Account_Id_On_Opportunity</targetReference>
            </connector>
            <label>Opp Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Primary_Contact_Set</name>
        <label>Primary Contact Set</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Error_Primary_Contact_Blank</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Primary Contact Blank</defaultConnectorLabel>
        <rules>
            <name>Has_Primary_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Customer_Contact.Primary_Contact__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contact</targetReference>
            </connector>
            <label>Has Primary Contact</label>
        </rules>
    </decisions>
