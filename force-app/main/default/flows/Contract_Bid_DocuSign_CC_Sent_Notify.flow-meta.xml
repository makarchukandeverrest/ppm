            </value>
        </inputParameters>
        <inputParameters>
            <name>relatedRecordId</name>
            <value>
                <elementReference>Get_Contract_Bid.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
        <versionString>2.0.1</versionString>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Email_To_Collection</name>
        <label>Add Email To Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ccEmailAddresses</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_CC_Recipients.dfsle__Email__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_CC_Recipients</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_CC_Recipients</name>
        <label>Count CC Recipients</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ccRecipientCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_CC_Recipients</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_Any_CCs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_Emails_To_Send</name>
        <label>Count Emails To Send</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ccEmailCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>ccEmailAddresses</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_Has_Emails_To_Send</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decision_Any_CCs</name>
        <label>Any CCs?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No CCs</defaultConnectorLabel>
        <rules>
            <name>Has_CC_Recipients</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ccRecipientCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_CC_Recipients</targetReference>
            </connector>
            <label>Has CC Recipients</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Bid_Found</name>
        <label>Bid Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not a Contract Bid</defaultConnectorLabel>
        <rules>
            <name>Contract_Bid_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contract_Bid.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contract_Bid</targetReference>
            </connector>
            <label>Contract Bid Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Has_Email</name>
        <label>Has Email?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_CC_Recipients</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Skip Blank Email</defaultConnectorLabel>
        <rules>
            <name>Email_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_CC_Recipients.dfsle__Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_CC_Recipients.dfsle__Email__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Email_To_Collection</targetReference>
            </connector>
            <label>Email Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Has_Emails_To_Send</name>
        <label>Has Emails To Send?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Emails</defaultConnectorLabel>
        <rules>
            <name>Ready_To_Send</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ccEmailCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Contract_Sent_Email</targetReference>
            </connector>
            <label>Ready To Send</label>
        </rules>
    </decisions>
    <description>Sends an additional Salesforce email to DocuSign Carbon Copy recipients when a Contract Bid envelope is sent (dfsle__SourceId__c = Contract Bid Id, dfsle__Sent__c populated). Sandbox checks before activate: (1) confirm dfsle__SourceId__c holds Contract Bid Id after send; (2) confirm dfsle__Recipient__c Role contains Carbon Copy with emails when Sent is set; (3) if recipients lag behind Sent, add a 1-2 min scheduled path on dfsle__Sent__c; (4) send one Contract Bid envelope and confirm CCs get both DocuSign and Salesforce notices.</description>
    <environments>Default</environments>
    <formulas>
        <name>Now_Date_TIME</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Contract Bid DocuSign CC Sent Notify {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contract Bid DocuSign CC Sent Notify</label>
    <loops>
        <name>Loop_CC_Recipients</name>
        <label>Loop CC Recipients</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_CC_Recipients</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_Has_Email</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Count_Emails_To_Send</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_CC_Recipients</name>
        <label>Get CC Recipients</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_CC_Recipients</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>dfsle__Envelope__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>dfsle__Role__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Carbon Copy</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>dfsle__Recipient__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>dfsle__Email__c</queriedFields>
        <queriedFields>dfsle__Role__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Contract_Bid</name>
        <label>Get Contract Bid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Bid_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.dfsle__SourceId__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contract_Bid__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Customer__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Contract_Bid</name>
        <label>Update Contract Bid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_CC_Recipients</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Contract_Bid.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Sent_Contract_Date__c</field>
            <value>
                <elementReference>Now_Date_TIME</elementReference>
            </value>
        </inputAssignments>
        <object>Contract_Bid__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Contract_Bid</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>dfsle__SourceId__c</field>
            <operator>StartsWith</operator>
            <value>
                <stringValue>a0b</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sent</stringValue>
            </value>
        </filters>
        <object>dfsle__Envelope__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
