    <textTemplates>
        <name>Reminder1Body</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hi {!Get_Recipients.Name},&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Just a quick note to confirm that the repair and supplies proposal came through on your end.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;If you didn’t receive it or would like it to be resent, I’m glad to do so. Please let me know if you have any questions or would like to review any items together.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thank you,&lt;/p&gt;&lt;p&gt;{!Get_Regional_Manager.Name}&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>Reminder2Body</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hi {!Get_Recipients_2.Name},&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Just a quick note to confirm that the repair and supplies proposal came through on your end.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;If you didn’t receive it or would like it to be resent, I’m glad to do so. Please let me know if you have any questions or would like to review any items together.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thank you,&lt;/p&gt;&lt;p&gt;{!Get_Regional_Manager_2.Name}&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>Reminder3Body</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hi {!Get_Recipients_3.Name},&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Just following up on my previous email.&lt;/p&gt;&lt;p&gt;If helpful, I’d be glad to schedule a quick call or site visit to walk through the proposed repairs and supplies, answer any questions, and align on priorities.&lt;/p&gt;&lt;p&gt;Please let me know what works best for you.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thank you,&lt;/p&gt;&lt;p&gt;{!Regional_Manager_3.Name}&lt;/p&gt;</text>
    </textTemplates>
