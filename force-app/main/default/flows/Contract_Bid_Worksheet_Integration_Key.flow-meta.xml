<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description
  >Sets Contract Bid Name and Worksheet Integration Key to Customer Name + Contract Year on create, or when Customer / Name / Contract Year change.</description>
    <environments>Default</environments>
    <formulas>
        <name>Customer_Year_Name_Formula</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK($Record.Customer__r.Name),
  IF(
    ISBLANK(TEXT($Record.Contract_Year__c)),
    $Record.Name,
    TRIM(
      IF(
        REGEX(RIGHT($Record.Name, 9), &quot;[0-9]{4}-[0-9]{4}&quot;),
        LEFT($Record.Name, LEN($Record.Name) - 9),
        IF(
          REGEX(RIGHT($Record.Name, 11), &quot;[0-9]{4} - [0-9]{4}&quot;),
          LEFT($Record.Name, LEN($Record.Name) - 11),
          $Record.Name
        )
      )
    ) &amp; &quot; &quot; &amp; SUBSTITUTE(TEXT($Record.Contract_Year__c), &quot;-&quot;, &quot; - &quot;)
  ),
  IF(
    ISBLANK(TEXT($Record.Contract_Year__c)),
    TRIM($Record.Customer__r.Name),
    TRIM($Record.Customer__r.Name) &amp; &quot; &quot; &amp; SUBSTITUTE(TEXT($Record.Contract_Year__c), &quot;-&quot;, &quot; - &quot;)
  )
)</expression>
    </formulas>
    <interviewLabel
  >Contract Bid Worksheet Integration Key {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contract Bid Worksheet Integration Key</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Fill_Name_And_Worksheet_Integration_Key</name>
        <label>Fill Name And Worksheet Integration Key</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Customer_Year_Name_Formula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Worksheet_Integration_Key__c</field>
            <value>
                <elementReference>Customer_Year_Name_Formula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference
      >Fill_Name_And_Worksheet_Integration_Key</targetReference>
        </connector>
        <filterFormula
    >OR(ISNEW(), ISCHANGED({!$Record.Customer__c}), ISCHANGED({!$Record.Name}), ISCHANGED({!$Record.Contract_Year__c}))</filterFormula>
        <object>Contract_Bid__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
