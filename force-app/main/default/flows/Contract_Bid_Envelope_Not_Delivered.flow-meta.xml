    <description
  >Creates one follow-up Task on the Contract Bid for the Customer Regional Manager 7 days after a DocuSign envelope is sent, if the signer Recipient Status is still Sent and was not Delivered. Skips when an open task with the same subject already exists on the bid.</description>
    <environments>Default</environments>
    <formulas>
        <name>TaskDescription</name>
        <dataType>String</dataType>
        <expression
    >&quot;DocuSign envelope &quot; &amp; $Record.Name &amp; &quot; signer is still Sent after 7 days and was not Delivered. Please follow up.&quot;</expression>
    </formulas>
    <formulas>
        <name>TaskDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>TaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Follow up: Contract not delivered&quot;</expression>
    </formulas>
    <interviewLabel
  >Contract Bid Envelope Not Delivered {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contract Bid Envelope Not Delivered</label>
