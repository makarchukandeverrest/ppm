<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_Contract_Bid</name>
        <label>Is Contract Bid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Contract_Bid_Source</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.dfsle__EnvelopeStatus__r.dfsle__SourceId__c</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>a0b</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Viewed</targetReference>
            </connector>
            <label>Contract Bid</label>
        </rules>
    </decisions>
    <description
  >On DocuSign recipient Viewed/Delivered for a Contract Bid: set Viewed, Opened Date, Next Follow-up = TODAY() + 2. No task.</description>
    <environments>Default</environments>
    <formulas>
        <name>NextFollowUpDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 2</expression>
    </formulas>
    <interviewLabel
  >Contract Bid Follow-Up Viewed {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contract Bid Follow-Up Viewed</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Mark_Viewed</name>
        <label>Mark Viewed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference
        >$Record.dfsle__EnvelopeStatus__r.dfsle__SourceId__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Viewed__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Viewed__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Opened_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Next_Follow_up_Date__c</field>
            <value>
                <elementReference>NextFollowUpDate</elementReference>
            </value>
        </inputAssignments>
        <object>Contract_Bid__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Contract_Bid</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria
    >true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>or</filterLogic>
        <filters>
            <field>dfsle__Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Viewed</stringValue>
            </value>
        </filters>
        <filters>
            <field>dfsle__Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Delivered</stringValue>
            </value>
        </filters>
        <object>dfsle__RecipientStatus__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
