<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_School_Off_Season_Weekly_Hours__c</fullName>
    <externalId>false</externalId>
    <formula>ROUND(
(VALUE(LEFT(TEXT(SchoolOff_Season_Monday_Close_Time__c), 2))
- VALUE(LEFT(TEXT(SchoolOff_Season_Monday_Open_Time__c), 2)))
+
(VALUE(MID(TEXT(SchoolOff_Season_Monday_Close_Time__c), 4, 2))/60
- VALUE(MID(TEXT(SchoolOff_Season_Monday_Open_Time__c), 4, 2))/60)
+
(VALUE(LEFT(TEXT(SchoolOff_Season_Tuesday_Close_Time__c), 2))
- VALUE(LEFT(TEXT(SchoolOff_Season_Tuesday_Open_Time__c), 2)))
+
(VALUE(MID(TEXT(SchoolOff_Season_Tuesday_Close_Time__c), 4, 2))/60
- VALUE(MID(TEXT(SchoolOff_Season_Tuesday_Open_Time__c), 4, 2))/60)
+
(VALUE(LEFT(TEXT(SchoolOff_Season_Wednesday_Close_Time__c), 2))
- VALUE(LEFT(TEXT(SchoolOff_Season_Wednesday_Open_Time__c), 2)))
+
(VALUE(MID(TEXT(SchoolOff_Season_Wednesday_Close_Time__c), 4, 2))/60
- VALUE(MID(TEXT(SchoolOff_Season_Wednesday_Open_Time__c), 4, 2))/60)
+
(VALUE(LEFT(TEXT(SchoolOff_Season_Thursday_Close_Time__c), 2))
- VALUE(LEFT(TEXT(SchoolOff_Season_Thursday_Open_Time__c), 2)))
+
(VALUE(MID(TEXT(SchoolOff_Season_Thursday_Close_Time__c), 4, 2))/60
- VALUE(MID(TEXT(SchoolOff_Season_Thursday_Open_Time__c), 4, 2))/60)
+
(VALUE(LEFT(TEXT(SchoolOff_Season_Friday_Close_Time__c), 2))
- VALUE(LEFT(TEXT(SchoolOff_Season_Friday_Open_Time__c), 2)))
+
(VALUE(MID(TEXT(SchoolOff_Season_Friday_Close_Time__c), 4, 2))/60
- VALUE(MID(TEXT(SchoolOff_Season_Friday_Open_Time__c), 4, 2))/60)
+
(VALUE(LEFT(TEXT(SchoolOff_Season_Saturday_Close_Time__c), 2))
- VALUE(LEFT(TEXT(SchoolOff_Season_Saturday_Open_Time__c), 2)))
+
(VALUE(MID(TEXT(SchoolOff_Season_Saturday_Close_Time__c), 4, 2))/60
- VALUE(MID(TEXT(SchoolOff_Season_Saturday_Open_Time__c), 4, 2))/60)
+
(VALUE(LEFT(TEXT(SchoolOff_Season_Sunday_Close_Time__c), 2))
- VALUE(LEFT(TEXT(SchoolOff_Season_Sunday_Open_Time__c), 2)))
+
(VALUE(MID(TEXT(SchoolOff_Season_Sunday_Close_Time__c), 4, 2))/60
- VALUE(MID(TEXT(SchoolOff_Season_Sunday_Open_Time__c), 4, 2))/60)
,
2)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total School/Off Season Weekly Hours</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
